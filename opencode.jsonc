{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/ornith-1.5:9b",
  "default_agent": "build",

  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },

    {
      "action": "notion_*",
      "resource": "*",
      "effect": "deny"
    },

    {
      "action": "notion_notion-fetch",
      "resource": "*",
      "effect": "allow"
    }
  ]
}